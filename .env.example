# Copier ce fichier en ".env" puis ajuster.

# --- Accès ---
# Docker Desktop pour Mac : 127.0.0.1 (accès uniquement depuis le Mac)
# Synology              : 0.0.0.0   (accès depuis les PC du réseau local)
BIND_IP=127.0.0.1
HTTP_PORT=3000
HTTPS_PORT=3001

# Mot de passe demandé par le navigateur (fortement conseillé sur Synology)
SLICER_USER=
SLICER_PASSWORD=

# --- Droits sur les fichiers ---
# Mac : 1000 / 1000 convient.
# Synology : mettez l'UID/GID de votre utilisateur DSM (commande `id` en SSH),
# souvent PUID=1026 et PGID=100.
PUID=1000
PGID=1000
TZ=Europe/Paris

# --- Images (pour figer une version, remplacer latest par un tag précis) ---
ORCA_IMAGE=lscr.io/linuxserver/orcaslicer:latest
PROXY_IMAGE=nginx:1.27-alpine
