# Réglages lus automatiquement par `docker compose` (fichier ".env").
# Dans le zip hors-ligne, il est déjà fourni sous le nom ".env" : les valeurs
# par défaut conviennent pour un Mac. Modifiez-le avec un éditeur de texte si
# besoin (dans le Finder : Cmd+Maj+. pour afficher les fichiers cachés).

# --- Accès ---
# Docker Desktop pour Mac : 127.0.0.1 (accès uniquement depuis le Mac)
# Synology              : 0.0.0.0   (accès depuis les PC du réseau local)
BIND_IP=127.0.0.1
HTTP_PORT=3000
HTTPS_PORT=3001
# Port de la page d'envoi/téléchargement des fichiers
FILES_PORT=3002

# Identifiants demandés par le navigateur, pour le slicer ET la page fichiers
# (fortement conseillé sur Synology)
SLICER_USER=
SLICER_PASSWORD=

# --- Droits sur les fichiers ---
# Mac : 1000 / 1000 convient.
# Synology : mettez l'UID/GID de votre utilisateur DSM (commande `id` en SSH),
# souvent PUID=1026 et PGID=100.
PUID=1000
PGID=1000
TZ=Europe/Paris
